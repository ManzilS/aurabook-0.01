# Production deployment environment variables
# Copy to .env and fill in all values before deploying

# Your domain (Caddy will auto-provision TLS certificate via Let's Encrypt)
DOMAIN=aurabook.example.com

# Database
POSTGRES_PASSWORD=  # Generate: openssl rand -hex 32

# API authentication
API_SHARED_SECRET=  # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=     # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# GitHub OAuth (create at https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Embedding provider
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Stripe billing (optional for free-tier-only launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Format: price_id:plan_name,price_id:plan_name
STRIPE_PRICE_PLAN_MAP=
