AURABOOK_CLOUD_API_HOST=0.0.0.0
AURABOOK_CLOUD_API_PORT=8000
AURABOOK_CLOUD_LOG_LEVEL=INFO
AURABOOK_CLOUD_DEMO_MODE=true
AURABOOK_CLOUD_API_SHARED_SECRET=

# Authentication: set to true to require API keys on all endpoints
AURABOOK_CLOUD_REQUIRE_API_KEY=false
# Rate limiting (requests per minute / burst capacity)
AURABOOK_CLOUD_RATE_LIMIT_RPM=120
AURABOOK_CLOUD_RATE_LIMIT_BURST=30

# GitHub OAuth (required for user login)
AURABOOK_CLOUD_GITHUB_CLIENT_ID=
AURABOOK_CLOUD_GITHUB_CLIENT_SECRET=
AURABOOK_CLOUD_GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Session signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AURABOOK_CLOUD_SESSION_SECRET=
# Frontend URL to redirect to after OAuth login
AURABOOK_CLOUD_FRONTEND_URL=http://localhost:3000
AURABOOK_CLOUD_DEMO_STORE_PATH=.demo/cloud_brain.json

# Database backend: "postgres", "supabase", or "demo" (auto-detected from available config)
AURABOOK_CLOUD_DB_BACKEND=
# Direct Postgres connection (used when db_backend=postgres)
AURABOOK_CLOUD_DATABASE_URL=
# Comma-separated CORS origins (leave empty for localhost-only default)
AURABOOK_CLOUD_CORS_ALLOWED_ORIGINS=

# Supabase (used when db_backend=supabase)
AURABOOK_CLOUD_SUPABASE_URL=
AURABOOK_CLOUD_SUPABASE_SERVICE_ROLE_KEY=
AURABOOK_CLOUD_DEMO_SUPABASE_URL=
AURABOOK_CLOUD_DEMO_SUPABASE_SERVICE_ROLE_KEY=
AURABOOK_CLOUD_DEMO_RUNTIME_ENVIRONMENT=standard
AURABOOK_CLOUD_GENERATION_PROVIDER=openai
AURABOOK_CLOUD_EMBEDDING_PROVIDER=openai
AURABOOK_CLOUD_GENERATION_MODEL=
AURABOOK_CLOUD_SUMMARY_MODEL=
AURABOOK_CLOUD_FIX_MODEL=
AURABOOK_CLOUD_EMBEDDING_MODEL=
AURABOOK_CLOUD_PROVIDER_REQUEST_TIMEOUT=120
AURABOOK_CLOUD_PROVIDER_MAX_OUTPUT_TOKENS=2048
AURABOOK_CLOUD_OPENAI_BASE_URL=https://api.openai.com/v1
AURABOOK_CLOUD_OPENAI_API_KEY=
AURABOOK_CLOUD_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AURABOOK_CLOUD_OPENAI_SUMMARY_MODEL=gpt-5.4-mini
AURABOOK_CLOUD_OPENAI_FIX_MODEL=gpt-5-codex
AURABOOK_CLOUD_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AURABOOK_CLOUD_OLLAMA_API_KEY=ollama
AURABOOK_CLOUD_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
AURABOOK_CLOUD_LMSTUDIO_API_KEY=lm-studio
AURABOOK_CLOUD_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AURABOOK_CLOUD_QWEN_API_KEY=
AURABOOK_CLOUD_ANTHROPIC_BASE_URL=https://api.anthropic.com
AURABOOK_CLOUD_ANTHROPIC_API_KEY=
AURABOOK_CLOUD_ANTHROPIC_VERSION=2023-06-01
AURABOOK_CLOUD_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AURABOOK_CLOUD_GEMINI_API_KEY=
